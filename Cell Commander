/* ------------------------------------------------------------------ *
 * Setup layout correction (landscape tablets and laptops)
 *
 * The four setup steps were laid out as four side-by-side columns whose tracks
 * resolved against their CONTENT rather than the viewport, so on a 1180px iPad the
 * container measured 1539px and step D — the tissue map, the one thing a child has to
 * touch — was pushed off the right edge behind a horizontal scrollbar.
 *
 * Two changes: hard-constrain every container to the viewport width, and give the map
 * its own full-height column so it dominates the screen instead of competing with three
 * panels of text. Reading the biopsy, picking a target, and buying cells all stack in a
 * narrow left rail, which is also the order a child works through them.
 * ------------------------------------------------------------------ */

.setup-screen {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow-x: hidden;
}

.setup-workflow {
  width: 100%;
  max-width: 100%;
  min-width: 0;
}

@media (min-width: 901px) and (orientation: landscape) {
  .setup-workflow {
    grid-template-columns: minmax(300px, 29%) minmax(0, 1fr);
    /* All three left-rail steps share the column and scroll internally. Sizing rows by
       content pushed step C (the shop, where the checkpoint inhibitor is bought) below the
       fold with no way to reach it. */
    grid-template-rows: minmax(0, 0.75fr) minmax(0, 1.05fr) minmax(0, 1.2fr);
    align-content: stretch;
  }

  .setup-step--a { grid-column: 1; grid-row: 1; }
  .setup-step--b { grid-column: 1; grid-row: 2; }
  .setup-step--c { grid-column: 1; grid-row: 3; }

  /* The map spans the full height of the right-hand column. */
  .setup-step--d {
    grid-column: 2;
    grid-row: 1 / -1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .setup-step--d .placement-board-wrap {
    flex: 1 1 auto;
    min-height: 0;
  }
}

/* The cell palette scrolls within itself rather than widening the page. */
.setup-bottom-bar {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow: hidden;
}

.setup-palette {
  min-width: 0;
  overflow-x: auto;
  overscroll-behavior-x: contain;
  -webkit-overflow-scrolling: touch;
}

/* ------------------------------------------------------------------ *
 * The `hidden` attribute must actually hide things.
 *
 * The UA stylesheet implements [hidden] as a plain `display: none`, which any class-based
 * `display` rule outranks. live.js hides its fallback HUD with `el.hidden = true` once the
 * real renderer HUD mounts, but `.ui-hud-fallback { display: ... }` won the cascade, so
 * BOTH panels rendered — the instrument column showed the cancer-cell count twice, with
 * two clocks disagreeing (elapsed vs remaining). Making [hidden] authoritative fixes this
 * and every future instance of the same mistake.
 * ------------------------------------------------------------------ */
[hidden] {
  display: none !important;
}

/* Channel rail labels were truncating to "Danger Sc…". Give them room to wrap. */
.channel-rail {
  min-width: 78px;
}

.channel-rail button,
.channel-rail .channel-toggle {
  white-space: normal;
  line-height: 1.15;
  hyphens: auto;
}

/* Channel toggles were 56px wide, which truncated every label to "Danger Sc…".
   Widen slightly and let the caption wrap onto two lines. */
.channel-toggle {
  width: 72px;
  min-width: 72px;
  padding-inline: 0.25rem;
  white-space: normal;
  line-height: 1.1;
  font-size: 0.625rem;
  letter-spacing: 0.02em;
  text-align: center;
  word-break: normal;
  overflow-wrap: anywhere;
}

/* The channel captions were capped at 48px with nowrap + ellipsis, so every one of them
   read "Danger Sc…" / "Alarm Sig…" / "Calm-Down…". A rail of unreadable labels is a rail of
   mystery buttons, which is the opposite of the point — these name the five molecules the
   game is about. Let them wrap onto two lines instead. */
.channel-toggle {
  width: 76px;
  min-width: 76px;
  height: auto;
  min-height: 64px;
  padding-block: 0.3rem;
}

.channel-toggle__short {
  max-width: 100%;
  overflow: visible;
  white-space: normal;
  text-overflow: clip;
  font-size: 0.5rem;
  line-height: 1.15;
  overflow-wrap: break-word;
}

/* ==================================================================== *
 * Accessibility corrections from the adversarial review round.
 * Legibility, contrast, and touch-target floors from docs/UX.md section 9.
 * ==================================================================== */

/* --ink-faint was #47586B — about 2.4:1 on the panel ground, well under the 4.5:1 floor,
   and it was carrying live body text (the leaderboard rank column), not just disabled
   states. Lightened to clear the floor while staying a visibly quieter step than
   --ink-dim. */
:root {
  --ink-faint: #6F8296;
}

/* The channel captions were the smallest type in the app at 8px — below the design's own
   smallest step and unreadable at arm's length on a tablet. These five labels name the
   molecules the whole game is about, so they have to be readable. Raised to the micro step
   and the rail widened to fit two wrapped words. */
.channel-toggle {
  width: 94px;
  min-width: 94px;
  min-height: 68px;
}

.channel-toggle__short {
  max-width: 100%;
  overflow: visible;
  white-space: normal;
  text-overflow: clip;
