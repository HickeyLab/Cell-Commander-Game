 * static geometric tumor center. Measured directly why this matters: in Cold Tumor
 * (spreadWu 90), by mid-round the *closest* surviving tumor cell to the geometric center was
 * 133wu away, average 163wu -- well outside engagement range. A chain that always terminates
 * at that fixed, often-empty point pulls arriving reinforcements to a spot with nothing to
 * fight, and the persistent refresh then holds them orbiting there instead of letting them
 * fan out to where cells actually are.
 *
 * Picks the *nearest* live cell to the origin, not a random one -- tried random first and it
 * made things worse: since this runs on every ~1s refresh, a fresh random pick each call kept
 * changing the destination faster than a cell moving at normal speed could reach the previous
 * one, so the signal never stayed put long enough to actually be followed. Nearest-to-origin
 * is deterministic and only changes when that specific cell dies, giving a stable target for
 * the whole time a wave's reinforcements are in transit.
 *
 * Falls back to the level's tumor center only if no tumor cells remain (e.g. round already
 * effectively won).
 */
function findWaveGuideDestination(round, originX, originY) {
  const world = round.world;
  let nearest = -1;
  let nearestDistanceSq = Infinity;
  for (let i = 0; i < world.capacity; i += 1) {
    if (world.alive[i] === 0 || world.kind[i] !== KIND.TUMOR) {
      continue;
    }
    const dx = world.x[i] - originX;
    const dy = world.y[i] - originY;
    const distanceSq = dx * dx + dy * dy;
    if (distanceSq < nearestDistanceSq) {
      nearest = i;
      nearestDistanceSq = distanceSq;
    }
  }
  if (nearest >= 0) {
    return { x: world.x[nearest], y: world.y[nearest] };
  }
  const tumor = round.level?.tumor;
  return tumor ? { x: tumor.cx, y: tumor.cy } : null;
}

function findNearestVessel(world, x, y) {
  let vessel = -1;
  let nearestDistanceSq = Infinity;
  for (let i = 0; i < world.capacity; i += 1) {
    if (world.alive[i] === 0 || world.kind[i] !== KIND.VESSEL) {
      continue;
    }
    const dx = world.x[i] - x;
    const dy = world.y[i] - y;
    const distanceSq = dx * dx + dy * dy;
    if (distanceSq < nearestDistanceSq) {
      vessel = i;
      nearestDistanceSq = distanceSq;
    }
  }
  return vessel;
}

function queueWave(dc) {
  const world = this.world;
  const vessel = findNearestVessel(world, world.x[dc], world.y[dc]);
  if (vessel < 0) {
    return false;
  }

  let queued = 0;
  const entryDistance = world.radius[vessel] + P.radius[KIND.CD8];
  for (let n = 0; n < P.dc.waveSize; n += 1) {
    const angle = this.rng.angle();
    const x = clamp(world.x[vessel] + Math.cos(angle) * entryDistance, 0, WORLD_W);
    const y = clamp(world.y[vessel] + Math.sin(angle) * entryDistance, 0, WORLD_H);
    if (queueSpawn.call(
      this,
      KIND.CD8,
      x,
      y,
      1,
      0,
      0,
      -1,
      STATE.NAIVE,
      0,
    )) {
      queued += 1;
    }
  }
  if (queued > 0) {
    queueEvent.call(
      this,
      EVENT_WAVE,
      world.x[vessel],
      world.y[vessel],
      KIND.CD8,
      queued,
    );
    // A freshly-called wave has nowhere to go but "toward the tumor" -- lay a guiding chain
    // now, and arm updateDendritic's periodic refresh (world.a2, while MATURE) to keep
    // re-laying it for DC_WAVE_GUIDE_DURATION_SEC. These new arrivals have no existing
    // productive position a signal could pull them away from, and one deposit alone fades
    // long before a cell moving at normal speed can cross a gap this large.
    const dest = findWaveGuideDestination(this, world.x[vessel], world.y[vessel]);
    if (dest) {
      layWaveGuideChain(this, world.x[vessel], world.y[vessel], dest.x, dest.y);
    }
    world.a2[dc] = Math.max(world.a2[dc], P.dc.waveGuideDurationSec);
  }
  return queued > 0;
}

/**
 * Re-lay the vessel-to-tumor guide chain for a DC that already has an active guide window
 * (world.a2[dc] > 0, armed by queueWave). Called on roughly a 1-second cadence from
 * updateDendritic rather than every tick -- frequent enough that a slow-moving reinforcement
 * never outruns the fading signal, without paying the deposit cost 60 times a second.
 */
function refreshWaveGuide(dc) {
  const world = this.world;
  const vessel = findNearestVessel(world, world.x[dc], world.y[dc]);
  if (vessel < 0) {
    return;
  }
  const dest = findWaveGuideDestination(this, world.x[vessel], world.y[vessel]);
  if (!dest) {
    return;
  }
  layWaveGuideChain(this, world.x[vessel], world.y[vessel], dest.x, dest.y);
}

function relaxNeighbor(other) {
  const round = relaxRound;
  const world = round.world;
  const i = relaxSlot;
  if (other <= i || world.alive[other] === 0
    || round._deathQueued[other] !== 0) {
    return;
  }

  let dx = world.x[other] - world.x[i];
  let dy = world.y[other] - world.y[i];
  let distanceSq = dx * dx + dy * dy;
  const minDistance = world.radius[i] + world.radius[other];
  if (distanceSq >= minDistance * minDistance) {
    return;
  }
  if (distanceSq <= Number.EPSILON) {
    dx = ((i + other) & 1) === 0 ? 1 : -1;
    dy = 0;
    distanceSq = 1;
  }
  const distance = Math.sqrt(distanceSq);
  const overlap = minDistance - distance;
  const nx = dx / distance;
  const ny = dy / distance;
  const fixedI = world.kind[i] === KIND.VESSEL;
  const fixedOther = world.kind[other] === KIND.VESSEL;
  if (fixedI && fixedOther) {
    return;
  }
  if (fixedI) {
    world.x[other] += nx * overlap;
    world.y[other] += ny * overlap;
  } else if (fixedOther) {
    world.x[i] -= nx * overlap;
    world.y[i] -= ny * overlap;
  } else {
    const half = overlap * 0.5;
    world.x[i] -= nx * half;
    world.y[i] -= ny * half;
    world.x[other] += nx * half;
    world.y[other] += ny * half;
  }
}

function relaxOverlaps(round) {
  const world = round.world;
  relaxRound = round;
  for (let iteration = 0; iteration < 2; iteration += 1) {
    for (let i = 0; i < world.capacity; i += 1) {
      if (world.alive[i] === 0 || round._deathQueued[i] !== 0) {
        continue;
      }
      relaxSlot = i;
      round.hash.forEachNeighbor(
        world.x[i],
        world.y[i],
        MAX_AGENT_RADIUS * 2,
        relaxNeighbor,
      );
    }
  }
  relaxSlot = -1;
  relaxRound = null;
}

function applyDeaths(round) {
  const world = round.world;
  for (let n = 0; n < round._deathCount; n += 1) {
    const victim = round._deathSlots[n];
    const killer = round._deathKillers[n];
    if (world.alive[victim] === 0) {
      round._deathQueued[victim] = 0;
      continue;
    }
    const victimKind = world.kind[victim];
    const x = world.x[victim];
    const y = world.y[victim];
    let killerKind = KIND.NONE;
    if (killer >= 0 && world.alive[killer] !== 0) {
      killerKind = world.kind[killer];
      world.a2[killer] += 1;
      world.a3[killer] = -1;
      world.timer[killer] = P.recognition.killCooldown;
      world.state[killer] = STATE.ACTIVE;
      round.stats.killsByKind[killerKind] += 1;
    }

    if (victimKind === KIND.TUMOR) {
      round.stats.tumorKilled += 1;
      round.grid.deposit(FIELD.DEBRIS, x, y, P.production.debrisPerDeath);
    } else if (victimKind === KIND.HEALTHY) {
      round.stats.healthyKilled += 1;
      round.patientHealth = Math.max(
        0,
        round.patientHealth - P.patient.healthPerHealthyCell,
      );
      queueEvent.call(round, EVENT_TOXICITY, x, y, 0, 0);
    }

    world.kill(victim);
    round._deathQueued[victim] = 0;
    queueEvent.call(round, EVENT_KILL, x, y, killerKind, victimKind);
  }
}

function applySpawns(round) {
  const world = round.world;
  for (let n = 0; n < round._spawnCount; n += 1) {
    const kind = round._spawnKind[n];
    const i = world.spawn(kind, round._spawnX[n], round._spawnY[n]);
    if (i < 0) {
      continue;
    }
    world.a0[i] = round._spawnA0[n];
    world.a1[i] = round._spawnA1[n];
    world.a2[i] = round._spawnA2[n];
    world.a3[i] = round._spawnA3[n];
    world.state[i] = round._spawnState[n];
    world.timer[i] = round._spawnTimer[n];
    if (kind === KIND.TUMOR) {
      queueEvent.call(
        round,
        EVENT_DIVIDE,
        round._spawnX[n],
        round._spawnY[n],
        0,
        0,
      );
    }
  }
}

function materializeEvents(round) {
  const events = round.events;
  for (let i = 0; i < round._eventCount; i += 1) {
    const code = round._eventCode[i];
    const x = round._eventX[i];
    const y = round._eventY[i];
    if (code === EVENT_KILL) {
      events.push({
        type: 'kill',
        x,
        y,
        killerKind: round._eventP0[i],
        victimKind: round._eventP1[i],
      });
    } else if (code === EVENT_DIVIDE) {
      events.push({ type: 'divide', x, y });
    } else if (code === EVENT_ENGAGE) {
      events.push({ type: 'engage', x, y });
    } else if (code === EVENT_POLARIZE) {
      events.push({ type: 'polarize', x, y, to: round._eventP0[i] });
    } else if (code === EVENT_WAVE) {
      events.push({
        type: 'wave',
        x,
        y,
        kind: round._eventP0[i],
        n: round._eventP1[i],
      });
    } else if (code === EVENT_TOXICITY) {
      events.push({ type: 'toxicity', x, y });
    }
  }
}

function updateMeters(round, dt) {
  const world = round.world;
  round.timeSec += dt;
  round.tumorCount = world.countOf(KIND.TUMOR);
  let immuneCount = 0;
  let engaged = 0;
  for (let i = 0; i < world.capacity; i += 1) {
    if (world.alive[i] === 0) {
      continue;
    }
    if (isImmuneKind(world.kind[i])) {
      immuneCount += 1;
    }
    if (world.state[i] === STATE.ENGAGED) {
      engaged += 1;
    }
  }
  round.immuneCount = immuneCount;

  let crsDrive = engaged * P.patient.crsPerEngagedKiller
    + round.grid.total(FIELD.IFNG)
      * round.grid.cellW
      * round.grid.cellH
      * P.patient.crsPerIfngMass;
  if (round.plan.il2) {
    crsDrive *= P.patient.crsIl2Multiplier;
  }
  round.crs = clamp(
    round.crs + crsDrive * dt - P.patient.crsRecoveryPerSec * round.crs * dt,
    0,
    1,
  );
  if (round.crs > P.patient.crsDanger) {
    round.patientHealth = Math.max(
      0,
      round.patientHealth
        - (round.crs - P.patient.crsDanger) * P.patient.crsHealthDamage * dt,
    );
  }

  round.stats.timeSec = round.timeSec;
  round.stats.tumorRemaining = round.tumorCount;
  round.stats.patientHealth = round.patientHealth;
  if (round.crs > round.stats.peakCrs) {
    round.stats.peakCrs = round.crs;
  }
  round.outcome = evaluateOutcome(round, round.level);
  round.stats.outcome = round.outcome;

  round._historyAccum += dt;
  if (round._historyAccum >= 1) {
    round._historyAccum -= 1;
    round.stats.history.push({
      t: round.timeSec,
      tumor: round.tumorCount,
      immune: round.immuneCount,
      crs: round.crs,
    });
  }
}

function tickRound(dt) {
  if (this.outcome !== OUTCOME.RUNNING || !(dt > 0)) {
    return;
  }
  this.events.length = 0;
  this._deathCount = 0;
  this._spawnCount = 0;
  this._eventCount = 0;
  this._deathQueued.fill(0);

  this._diffuseAccum += dt;
  this._diffuseTicks += 1;
  if (this._diffuseTicks >= this.quality.diffuseEvery) {
    this.grid.step(this._diffuseAccum, this._fieldParams);
    this._diffuseAccum = 0;
    this._diffuseTicks = 0;
  }

  this.hash.rebuild(this.world);

  const world = this.world;
  for (let i = 0; i < world.capacity; i += 1) {
    if (world.alive[i] === 0 || this._deathQueued[i] !== 0) {
      continue;
    }
    world.age[i] += dt;
    const kind = world.kind[i];
    if (kind === KIND.TUMOR) {
      updateTumor(this, i, dt);
    } else if (kind === KIND.CD8 || kind === KIND.CART) {
      updateTCell(this, i, dt);
    } else if (kind === KIND.NK) {
      updateNK(this, i, dt);
    } else if (kind === KIND.MACRO) {
      updateMacrophage(this, i, dt);
    } else if (kind === KIND.DC) {
      updateDendritic(this, i, dt);
    } else if (kind === KIND.CD4) {
      updateCD4(this, i, dt);
    } else if (kind === KIND.TREG) {
      updateTreg(this, i, dt);
    } else if (kind === KIND.HEALTHY) {
      updateHealthy(this, i, dt);
    }
  }

  for (let i = 0; i < world.capacity; i += 1) {
    if (world.alive[i] === 0 || this._deathQueued[i] !== 0) {
      continue;
    }
    world.x[i] = clamp(
      world.x[i] + world.vx[i] * dt,
      world.radius[i],
      WORLD_W - world.radius[i],
    );
    world.y[i] = clamp(
      world.y[i] + world.vy[i] * dt,
      world.radius[i],
      WORLD_H - world.radius[i],
    );
  }

  relaxOverlaps(this);
  for (let i = 0; i < world.capacity; i += 1) {
    if (world.alive[i] !== 0) {
      world.x[i] = clamp(world.x[i], world.radius[i], WORLD_W - world.radius[i]);
      world.y[i] = clamp(world.y[i], world.radius[i], WORLD_H - world.radius[i]);
    }
  }

  applyDeaths(this);
  applySpawns(this);
  materializeEvents(this);
  updateMeters(this, dt);
}

function drainEvents() {
  const drained = this.events;
  this.events = this._eventSpare;
  this.events.length = 0;
  this._eventSpare = drained;
  return drained;
}

function setSpeed(multiplier) {
  if (multiplier !== 1 && multiplier !== 2 && multiplier !== 3) {
    throw new RangeError('speed multiplier must be 1, 2, or 3');
  }
  this.speed = multiplier;
}

function abortRound() {
  if (this.outcome === OUTCOME.RUNNING) {
    this.outcome = OUTCOME.ABORTED;
    this.stats.outcome = OUTCOME.ABORTED;
  }
}

function computePerfusion(level, grid) {
  const perfusion = new Float32Array(grid.w * grid.h);
  const diagonal = Math.hypot(WORLD_W, WORLD_H);
  let total = 0;
  for (let cy = 0; cy < grid.h; cy += 1) {
    const y = (cy + 0.5) * grid.cellH;
    for (let cx = 0; cx < grid.w; cx += 1) {
      const x = (cx + 0.5) * grid.cellW;
      let nearest = diagonal;
      for (let v = 0; v < level.vessels.length; v += 1) {
        const dx = level.vessels[v].x - x;
        const dy = level.vessels[v].y - y;
        const distance = Math.hypot(dx, dy);
        if (distance < nearest) {
          nearest = distance;
        }
      }
      const value = Math.max(0, 1 - nearest / diagonal);
      perfusion[cy * grid.w + cx] = value;
      total += value;
    }
  }
  return {
    data: perfusion,
    mean: perfusion.length > 0 ? total / perfusion.length : 0,
  };
}

function spawnInitialAgents(round) {
  const world = round.world;
  const level = round.level;
  const rng = round.rng;

  for (let v = 0; v < level.vessels.length; v += 1) {
    world.spawn(KIND.VESSEL, level.vessels[v].x, level.vessels[v].y);
  }

  for (let n = 0; n < level.tumor.count; n += 1) {
    const x = clamp(
      rng.gauss(level.tumor.cx, level.tumor.spreadWu * 0.5),
      P.radius[KIND.TUMOR],
      WORLD_W - P.radius[KIND.TUMOR],
    );
    const y = clamp(
      rng.gauss(level.tumor.cy, level.tumor.spreadWu * 0.5),
      P.radius[KIND.TUMOR],
      WORLD_H - P.radius[KIND.TUMOR],
    );
    const i = world.spawn(KIND.TUMOR, x, y);
    if (i < 0) break;
    const antigen = sampleAntigen(level.tumor.antigenMix, rng);
    world.a0[i] = antigen;
    world.a1[i] = sampleMhc(rng, level.tumor, antigen);
    world.a2[i] = level.tumor.pdl1Base;
    world.a3[i] = 0;
    world.timer[i] = P.tumor.divideTimeSec
      * level.tumor.divideTimeScale
      * rng.range(0.8, 1.2);
  }

  for (let n = 0; n < level.healthy.count; n += 1) {
    const x = rng.range(P.radius[KIND.HEALTHY], WORLD_W - P.radius[KIND.HEALTHY]);
    const y = rng.range(P.radius[KIND.HEALTHY], WORLD_H - P.radius[KIND.HEALTHY]);
    const i = world.spawn(KIND.HEALTHY, x, y);
    if (i < 0) break;
    world.a0[i] = level.healthy.antigen;
  }

  const retainedTregs = round.plan.lymphodepletion
    ? Math.round(level.tregs * (1 - P.patient.lymphoTregKill))
    : level.tregs;
  for (let n = 0; n < retainedTregs; n += 1) {
    const x = clamp(
      rng.gauss(level.tumor.cx, level.tumor.spreadWu),
      P.radius[KIND.TREG],
      WORLD_W - P.radius[KIND.TREG],
    );
    const y = clamp(
      rng.gauss(level.tumor.cy, level.tumor.spreadWu),
      P.radius[KIND.TREG],
      WORLD_H - P.radius[KIND.TREG],
    );
    if (world.spawn(KIND.TREG, x, y) < 0) break;
  }

  for (let n = 0; n < round.plan.placements.length; n += 1) {
    const placement = round.plan.placements[n];
    if (world.spawn(
      placement.kind,
      clamp(placement.x, 0, WORLD_W),
      clamp(placement.y, 0, WORLD_H),
    ) < 0) {
      break;
    }
  }
}

// Exported for regression testing (see tests/mhc-independence.test.js), which needs to
// spawn cells with the exact same distributions the real game uses rather than a
// reimplementation that could silently drift out of sync with this file.


/**
 * Create a seeded headless simulation round from a level and treatment plan.
 * @param {{level:object, plan:object, seed:number, quality:object}} opts
 * @returns {object}
 */
function createRound(opts) {
  const rng = makeRng(opts.seed);
  const quality = opts.quality;
  const world = makeWorld({
    capacity: quality.maxAgents,
    worldW: WORLD_W,
    worldH: WORLD_H,
    rng,
  });
  const grid = makeFieldGrid({
    w: quality.gridW,
    h: quality.gridH,
    worldW: WORLD_W,
    worldH: WORLD_H,
    fieldCount: FIELD_COUNT,
    concentrationUnitArea: FIELD_CONCENTRATION_UNIT_AREA,
  });
  const hash = makeSpatialHash({
    worldW: WORLD_W,
    worldH: WORLD_H,
    cellSize: MAX_AGENT_RADIUS * 2 + P.recognition.engageMargin,
  });
  const perfusionResult = computePerfusion(opts.level, grid);
  const capacity = quality.maxAgents;
  const killsByKind = new Uint32Array(KIND.HEALTHY + 1);
  const startingHealth = opts.plan.lymphodepletion
    ? 100 - P.patient.lymphoHealthCost
    : 100;

  // API-NOTE: params.js exports no perfusion falloff or division threshold.
  // The static field is normalized by world diagonal and "lowest" is interpreted
  // relatively: after spawning, cells below the initial tumor's mean perfusion cannot divide.
  const round = {
    level: opts.level,
    plan: opts.plan,
    quality,
    world,
    grid,
    hash,
    rng,
    perfusion: perfusionResult.data,
    perfusionMean: perfusionResult.mean,
    timeSec: 0,
    outcome: OUTCOME.RUNNING,
    tumorCount: 0,
    immuneCount: 0,
    patientHealth: startingHealth,
    crs: 0,
    speed: 1,
    events: [],
    stats: {
      outcome: OUTCOME.RUNNING,
      timeSec: 0,
      tumorStart: 0,
      tumorRemaining: 0,
      tumorKilled: 0,
      healthyKilled: 0,
      patientHealth: startingHealth,
      peakCrs: 0,
      budgetUnspent: Math.max(0, opts.level.budget - planCost(opts.plan)),
      killsByKind,
      history: [],
    },
    _eventSpare: [],
    _fieldParams: { diffusion: P.diffusion, decay: P.decay },
    _gradientScratch: { x: 0, y: 0 },
    _beaconGradientScratch: { x: 0, y: 0 },
    _diffuseAccum: 0,
    _diffuseTicks: 0,
    _historyAccum: 0,
    _deathQueued: new Uint8Array(capacity),
    _deathSlots: new Int32Array(capacity),
    _deathKillers: new Int32Array(capacity),
    _deathCount: 0,
    _spawnKind: new Uint8Array(capacity),
    _spawnState: new Uint8Array(capacity),
    _spawnX: new Float32Array(capacity),
    _spawnY: new Float32Array(capacity),
    _spawnA0: new Float32Array(capacity),
    _spawnA1: new Float32Array(capacity),
    _spawnA2: new Float32Array(capacity),
    _spawnA3: new Float32Array(capacity),
    _spawnTimer: new Float32Array(capacity),
    _spawnCount: 0,
    _eventCode: new Uint8Array(MAX_EVENTS_PER_TICK),
    _eventX: new Float32Array(MAX_EVENTS_PER_TICK),
    _eventY: new Float32Array(MAX_EVENTS_PER_TICK),
    _eventP0: new Int32Array(MAX_EVENTS_PER_TICK),
    _eventP1: new Int32Array(MAX_EVENTS_PER_TICK),
    _eventCount: 0,
    _findTarget: findTarget,
    _queueDeath: queueDeath,
    _queueSpawn: queueSpawn,
    _queueEvent: queueEvent,
    _damageTarget: damageTarget,
    _recoverKiller: recoverKiller,
    _move: moveAgent,
    _perfusionAt: perfusionAt,
    _hasDivisionClearance: hasDivisionClearance,
    _takeDebris: takeDebris,
    _queueWave: queueWave,
    _refreshWaveGuide: refreshWaveGuide,
    tick: tickRound,
    drainEvents,
    setSpeed,
    abort: abortRound,
  };

  const planeSize = grid.w * grid.h;
  grid.data.fill(
    opts.level.startingChemokine / grid.concentrationUnitArea,
    FIELD.CHEMOKINE * planeSize,
    (FIELD.CHEMOKINE + 1) * planeSize,
  );
  grid.data.fill(
    opts.level.startingSuppress / grid.concentrationUnitArea,
    FIELD.SUPPRESS * planeSize,
    (FIELD.SUPPRESS + 1) * planeSize,
  );
  spawnInitialAgents(round);
  hash.rebuild(world);
  round.tumorCount = world.countOf(KIND.TUMOR);
  round.stats.tumorStart = round.tumorCount;
  round.stats.tumorRemaining = round.tumorCount;
  let immuneCount = 0;
  let tumorPerfusionTotal = 0;
  let tumorPerfusionCount = 0;
  for (let i = 0; i < world.capacity; i += 1) {
    if (world.alive[i] === 0) {
      continue;
    }
