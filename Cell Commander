<style>
/**
 * styles.css — Cell Commander's offline fluorescence-micrograph visual system,
 * responsive instrument layouts, touch sizing, motion, and screen presentation.
 */

:root {
  --void: #05080C;
  --tissue: #0A1018;
  --tissue-warm: #0E1620;
  --panel: #101A26;
  --panel-edge: #1E2E40;

  --ink: #E8F2FA;
  --ink-dim: #7E93A8;
  --ink-faint: #47586B;

  --ch-tumor: #FF3D8B;
  --ch-cart: #22E0E8;
  --ch-cd8: #3D8BFF;
  --ch-nk: #FFB020;
  --ch-macro: #A77BFF;
  --ch-dc: #FF7AC8;
  --ch-cd4: #46D97A;
  --ch-treg: #B08A4A;
  --ch-vessel: #E0453A;
  --ch-healthy: #90A4B4;

  --ok: #46D97A;
  --warn: #FFB020;
  --danger: #FF4D4D;

  --font-instrument: ui-monospace, 'SF Mono', 'Cascadia Mono', Menlo, Consolas, monospace;
  --font-display: system-ui, -apple-system, 'Segoe UI Variable Display', 'Segoe UI', sans-serif;

  --type-display: 3.5rem;
  --type-h1: 2rem;
  --type-h2: 1.375rem;
  --type-body: 1.0625rem;
  --type-label: 0.8125rem;
  --type-micro: 0.6875rem;

  color-scheme: dark;
  font-family: var(--font-display);
  font-synthesis: none;
  font-variant-numeric: tabular-nums;
  background: var(--void);
  color: var(--ink);
}

* {
  box-sizing: border-box;
}

html {
  min-width: 320px;
  min-height: 100%;
  background: var(--void);
  overscroll-behavior: none;
  -webkit-text-size-adjust: 100%;
}

body {
  min-width: 320px;
  min-height: 100%;
  margin: 0;
  background: var(--void);
  color: var(--ink);
  font-size: var(--type-body);
  line-height: 1.5;
  overscroll-behavior: none;
  touch-action: manipulation;
}

button,
input,
textarea,
select,
output {
  color: inherit;
  font: inherit;
  font-variant-numeric: tabular-nums;
}

button,
input[type='range'] {
  touch-action: manipulation;
}

button:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible,
[tabindex]:focus-visible {
  outline: 2px solid var(--ch-cart);
  outline-offset: 3px;
}

button:disabled {
  cursor: not-allowed;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1,
h2,
.science-card {
  font-family: var(--font-display);
}

h1 {
  margin-bottom: 0.35rem;
  font-size: clamp(1.75rem, 2.4vw, var(--type-h1));
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1.05;
}

h2 {
  margin-bottom: 0.65rem;
  font-size: var(--type-h2);
  font-weight: 750;
  letter-spacing: -0.015em;
  line-height: 1.15;
}

p {
  margin-bottom: 0.9rem;
}

strong,
output,
.headline-readout,
.score-total,
.level-card__number {
  font-variant-numeric: tabular-nums;
}

#root {
  width: 100%;
  min-height: 100dvh;
  isolation: isolate;
}

.cc-screen {
  width: min(100%, 1920px);
  min-height: 100dvh;
  margin: 0 auto;
  background: var(--void);
}

.instrument-label,
.cc-button,
.cc-chip,
.cc-meter,
.cc-slider,
.cc-segmented,
.leaderboard-table,
.instrument-panel,
fieldset legend {
  font-family: var(--font-instrument);
}

.instrument-label,
fieldset legend {
  color: var(--ink-dim);
  font-size: var(--type-label);
  font-weight: 700;
  letter-spacing: 0.08em;
  line-height: 1.25;
  text-transform: uppercase;
}

.sr-only {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}

.cc-button {
  min-width: 56px;
  min-height: 56px;
  padding: 0.75rem 1rem;
  border: 1px solid var(--panel-edge);
  border-radius: 10px;
  background: var(--panel);
  color: var(--ink);
  font-size: var(--type-label);
  font-weight: 800;
  letter-spacing: 0.055em;
  line-height: 1.2;
  text-transform: uppercase;
  box-shadow: inset 0 1px 0 rgb(255 255 255 / 5%);
}

.cc-button:not(:disabled):active {
  transform: translateY(1px);
  background: var(--tissue-warm);
}

.cc-button--primary {
  border-color: color-mix(in srgb, var(--ch-cart) 75%, var(--panel-edge));
  background: var(--ch-cart);
  color: var(--void);
  box-shadow:
    0 0 24px rgb(34 224 232 / 17%),
    inset 0 1px 0 rgb(255 255 255 / 42%);
}

.cc-button--quiet {
  background: transparent;
  color: var(--ink-dim);
}

.cc-button--link {
  min-height: 56px;
  border-color: transparent;
  background: transparent;
  color: var(--ink-dim);
  text-decoration: underline;
  text-decoration-color: var(--panel-edge);
  text-underline-offset: 0.35em;
}

.cc-button--danger {
  border-color: color-mix(in srgb, var(--danger) 65%, var(--panel-edge));
  background: rgb(255 77 77 / 9%);
  color: #FFB1B1;
}

.cc-button:disabled,
.cc-button[aria-disabled='true'] {
  border-color: var(--panel-edge);
  background: rgb(16 26 38 / 45%);
  color: var(--ink-faint);
  box-shadow: none;
  opacity: 1;
}

.cc-button.is-active,
.cc-button[aria-pressed='true'] {
  border-color: var(--ch-cart);
  background: rgb(34 224 232 / 11%);
  color: var(--ink);
}

.cc-icon {
  display: inline-grid;
  min-width: 1.2em;
  place-items: center;
  margin-right: 0.45em;
  font-style: normal;
}

.cc-chip {
  display: inline-flex;
  min-height: 32px;
  align-items: center;
  padding: 0.35rem 0.65rem;
  border: 1px solid var(--panel-edge);
  border-radius: 999px;
  background: rgb(16 26 38 / 88%);
  color: var(--ink-dim);
  font-size: var(--type-micro);
  font-weight: 750;
  letter-spacing: 0.045em;
  line-height: 1.3;
  text-transform: uppercase;
}

.cc-chip--warn {
  border-color: rgb(255 176 32 / 48%);
  color: #FFD486;
}

.cc-chip--ok {
  border-color: rgb(70 217 122 / 48%);
  color: #8BF1AF;
}

.cc-chip--hint,
.cc-chip--science {
  border-color: rgb(34 224 232 / 34%);
  color: #A7F5F8;
}

.screen-header {
  display: flex;
  min-height: 92px;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: max(1rem, env(safe-area-inset-top)) clamp(1rem, 2.5vw, 2.5rem) 1rem;
  border-bottom: 1px solid var(--panel-edge);
  background: var(--panel);
}

.screen-header p:last-child {
  margin-bottom: 0;
  color: var(--ink-dim);
}

.instrument-panel {
  border: 1px solid var(--panel-edge);
  background:
    linear-gradient(180deg, rgb(255 255 255 / 2%), transparent 20%),
    var(--panel);
}

.cc-meter {
  display: grid;
  gap: 0.35rem;
}

.cc-meter__row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 0.75rem;
}

.cc-meter__value {
  min-width: 5ch;
  color: var(--ink);
  font-size: var(--type-label);
  font-weight: 800;
  text-align: right;
}

.cc-meter__track {
  height: 9px;
  overflow: hidden;
  border: 1px solid var(--panel-edge);
  border-radius: 2px;
  background: var(--tissue);
}

.cc-meter__fill {
  display: block;
  width: 0;
  height: 100%;
  background: var(--ch-cart);
  transition: width 140ms linear;
}

.cc-meter--health .cc-meter__fill {
  background: var(--ok);
}

.cc-meter--crs .cc-meter__fill {
  background: var(--danger);
}

.cc-segmented {
  display: flex;
  gap: 8px;
}

.cc-segmented__item {
  flex: 1 1 56px;
  padding-inline: 0.75rem;
}

.cc-modal {
  position: fixed;
  z-index: 100;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 1rem;
  background: rgb(5 8 12 / 85%);
}

.cc-modal__surface {
  width: min(560px, 100%);
  padding: 1.5rem;
  border: 1px solid var(--ch-cart);
  border-radius: 14px;
  background: var(--panel);
  box-shadow: 0 24px 80px rgb(0 0 0 / 55%);
}

/* Title acquisition */

.title-screen {
  display: grid;
  min-height: 100dvh;
  place-items: center;
  padding: clamp(0.75rem, 2vw, 2rem);
  overflow: hidden;
}

.title-field {
  position: relative;
  width: min(1180px, 100%);
  aspect-ratio: 3 / 2;
  max-height: calc(100dvh - 2rem);
  overflow: hidden;
  border: 1px solid var(--panel-edge);
  background:
    radial-gradient(circle at 66% 38%, rgb(255 61 139 / 9%), transparent 20%),
    radial-gradient(circle at 54% 72%, rgb(34 224 232 / 7%), transparent 24%),
    var(--tissue);
  box-shadow:
    0 28px 90px rgb(0 0 0 / 55%),
    inset 0 0 70px rgb(0 0 0 / 55%);
}

.title-field::after {
  position: absolute;
  inset: 0;
  border: 12px solid rgb(5 8 12 / 35%);
  content: '';
  pointer-events: none;
}

.title-hero {
  position: absolute;
  z-index: 4;
  top: 50%;
  left: clamp(1.5rem, 6vw, 5rem);
  width: min(590px, 62%);
  transform: translateY(-50%);
}

.title-hero h1 {
  max-width: 8ch;
  margin-bottom: 0.75rem;
  font-size: clamp(3rem, 7vw, var(--type-display));
  line-height: 0.92;
  text-shadow: 0 0 34px rgb(34 224 232 / 18%);
}

.title-hero > p:not(.instrument-label) {
  max-width: 42ch;
  color: var(--ink-dim);
}

.title-play {
  width: min(360px, 100%);
  min-height: 76px;
  margin-top: 0.6rem;
  font-size: 1rem;
}

.title-secondary-actions {
  display: flex;
  gap: 0.5rem;
  margin-top: 0.35rem;
}

.title-readouts {
  position: absolute;
  z-index: 4;
  right: clamp(1rem, 3vw, 2.5rem);
  bottom: clamp(1rem, 3vw, 2.5rem);
  display: grid;
  grid-template-columns: auto minmax(5ch, auto);
  gap: 0.4rem 1rem;
  width: 240px;
  padding: 1rem;
}

.title-readouts strong {
  color: var(--ch-cart);
  font-family: var(--font-instrument);
  text-align: right;
}

.title-specimen {
  position: absolute;
  inset: 0;
  opacity: 0.48;
}

.title-cell {
  position: absolute;
  top: var(--y);
  left: var(--x);
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--ch-tumor);
  box-shadow: 0 0 16px 5px rgb(255 61 139 / 25%);
}

.title-cell--1 {
  border-radius: 2px;
  background: var(--ch-cart);
  box-shadow: 0 0 16px 5px rgb(34 224 232 / 24%);
  transform: rotate(45deg);
}

.title-cell--2 {
  background: var(--ch-cd8);
  box-shadow: 0 0 15px 5px rgb(61 139 255 / 22%);
}

.title-cell--3 {
  width: 10px;
  height: 10px;
  border-radius: 0;
  background: var(--ch-nk);
  box-shadow: 0 0 14px 4px rgb(255 176 32 / 22%);
  transform: rotate(45deg);
}

.title-cell--4 {
  background: var(--ch-macro);
  box-shadow: 0 0 16px 5px rgb(167 123 255 / 22%);
}

.title-cell--5 {
  background: var(--ch-dc);
  box-shadow: 0 0 16px 5px rgb(255 122 200 / 22%);
}

.title-scan-line,
.acquisition-scan {
  position: absolute;
  z-index: 3;
  top: 0;
  bottom: 0;
  left: 0;
  width: 2px;
  background: var(--ch-cart);
  box-shadow: 0 0 18px 4px rgb(34 224 232 / 45%);
  animation: scan-across 1.1s cubic-bezier(0.3, 0.7, 0.2, 1) both;
  pointer-events: none;
}

@keyframes scan-across {
  from {
    left: 0;
    opacity: 0;
  }
  8% {
    opacity: 1;
  }
  92% {
    opacity: 1;
  }
  to {
    left: 100%;
    opacity: 0;
  }
}

/* Level select */

.level-select-screen,
.leaderboard-screen,
.results-screen,
.sandbox-screen {
  padding-bottom: max(1rem, env(safe-area-inset-bottom));
}

.level-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: clamp(0.8rem, 1.5vw, 1.25rem);
  padding: clamp(1rem, 2.5vw, 2.5rem);
}

.level-card {
  display: flex;
  min-height: 288px;
  flex-direction: column;
  padding: clamp(1rem, 1.8vw, 1.4rem);
  border: 1px solid var(--panel-edge);
  border-radius: 12px;
  background:
    linear-gradient(140deg, rgb(34 224 232 / 4%), transparent 48%),
    var(--panel);
}

.level-card.is-locked {
  background: rgb(16 26 38 / 50%);
}

.level-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  margin-bottom: 0.85rem;
}

.level-card__number {
  color: var(--ch-cart);
  font-family: var(--font-instrument);
  font-size: 2.4rem;
  font-weight: 850;
  letter-spacing: -0.06em;
}

.level-card p {
  color: var(--ink-dim);
}

.level-card__best {
  margin-top: auto;
  margin-bottom: 0.65rem;
}

.level-card__action {
  width: 100%;
}

.level-loading,
.route-failure {
  display: grid;
  min-height: 420px;
  place-items: center;
  align-content: center;
  padding: 2rem;
  text-align: center;
}

/* Setup */

.setup-screen {
  display: grid;
  height: 100dvh;
  grid-template-rows: auto minmax(0, 1fr) 96px;
  overflow: hidden;
}

.setup-workflow {
  display: grid;
  min-height: 0;
  grid-template-columns:
    minmax(168px, 0.85fr)
    minmax(178px, 0.9fr)
    minmax(220px, 1.1fr)
    minmax(330px, 1.75fr);
  gap: clamp(0.55rem, 1vw, 0.9rem);
  padding: clamp(0.7rem, 1.2vw, 1.1rem);
}

.setup-step {
  position: relative;
  min-width: 0;
  min-height: 0;
  padding: clamp(0.85rem, 1.2vw, 1.1rem);
  overflow: auto;
  border: 1px solid var(--panel-edge);
  border-radius: 10px;
  background: var(--panel);
  scrollbar-color: var(--panel-edge) transparent;
}

.setup-step__number {
  display: inline-grid;
  width: 28px;
  height: 28px;
  place-items: center;
  margin-bottom: 0.65rem;
  border: 1px solid var(--ch-cart);
  border-radius: 50%;
  color: var(--ch-cart);
}

.setup-step > p {
  color: var(--ink-dim);
}

.antigen--green {
  color: var(--ch-cd4);
}

.antigen--blue {
  color: var(--ch-cd8);
}

.antigen--orange {
  color: var(--ch-nk);
}

.antigen--none {
  color: var(--ch-healthy);
}

.tumor-specs-card {
  display: grid;
  gap: 0.35rem;
  padding: 0.9rem 1rem;
  border: 1px solid var(--panel-edge);
  border-left: 4px solid currentColor;
  border-radius: 8px;
  background: var(--tissue);
}

.tumor-specs__name {
  color: currentColor;
  font-size: 1.05rem;
}

.tumor-specs__marker,
.tumor-specs__stats,
.tumor-specs__profile {
  margin: 0;
  color: var(--ink-dim);
  font-family: var(--font-display);
  font-size: 0.85rem;
  letter-spacing: 0;
  text-transform: none;
}

.tumor-specs__stats {
  color: var(--ink);
}

.inline-caution,
.disabled-reason {
  min-height: 2.7em;
  margin: 0.65rem 0 0;
  color: #FFD486;
  font-size: 0.84rem;
  line-height: 1.35;
}

.shop-list {
  display: grid;
  gap: 0.5rem;
  margin-top: 0.85rem;
}

.shop-list--drugs {
  padding-top: 0.85rem;
  border-top: 1px solid var(--panel-edge);
}

.budget-remaining {
  margin: 0.45rem 0 0;
  color: var(--ch-cart);
  font-family: var(--font-instrument);
  font-size: var(--type-label);
  font-weight: 800;
  text-transform: uppercase;
}

.shop-item {
  display: grid;
  min-height: 74px;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 0.15rem 0.7rem;
  align-items: center;
  padding: 0.65rem 0.75rem;
  text-align: left;
}

.shop-item strong {
  color: var(--ch-cart);
  white-space: nowrap;
}

.shop-item__reason {
  grid-column: 1 / -1;
  color: var(--ink-dim);
  font-family: var(--font-display);
  font-size: 0.76rem;
  font-weight: 500;
  letter-spacing: 0;
  line-height: 1.25;
  text-transform: none;
}

.shop-item:disabled .shop-item__reason {
  color: #9B7F58;
}

.cell-identity {
  min-width: 0;
  overflow-wrap: anywhere;
}

.cell-identity--cart {
  color: var(--ch-cart);
}

.cell-identity--cd8 {
  color: var(--ch-cd8);
}

.cell-identity--nk {
  color: var(--ch-nk);
}

.cell-identity--macro {
  color: var(--ch-macro);
}

.cell-identity--dc {
  color: var(--ch-dc);
}

.cell-identity--cd4 {
  color: var(--ch-cd4);
}

.placement-step {
  display: grid;
  grid-template-rows: auto auto minmax(220px, 1fr) auto;
  overflow: hidden;
}

.placement-board-wrap {
  position: relative;
  min-height: 220px;
  overflow: hidden;
  border: 1px solid var(--panel-edge);
  border-radius: 7px;
  background: var(--tissue);
}

.placement-board,
.tissue-canvas {
  display: block;
  width: 100%;
  height: 100%;
  touch-action: none;
}

.placement-message {
  position: absolute;
  z-index: 8;
  width: min(230px, calc(100% - 16px));
  padding: 0.55rem 0.7rem;
  border: 1px solid var(--warn);
  border-radius: 7px;
  background: rgb(5 8 12 / 94%);
  color: #FFE0A3;
  font-size: 0.78rem;
  line-height: 1.3;
  opacity: 0;
  pointer-events: none;
  transform: translateY(4px);
  transition: opacity 120ms ease, transform 120ms ease;
}

.placement-message.is-visible {
  opacity: 1;
  transform: none;
}

.placement-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.6rem;
  padding-top: 0.65rem;
}

.setup-bottom-bar {
  display: flex;
  min-height: 96px;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.6rem clamp(1rem, 2vw, 2rem) max(0.6rem, env(safe-area-inset-bottom));
  border-top: 1px solid var(--panel-edge);
  background: var(--panel);
}

.setup-palette {
  display: flex;
  min-width: 0;
  flex: 1 1 auto;
  gap: 8px;
  margin: 0;
  padding-bottom: 2px;
  overflow-x: auto;
  scroll-snap-type: x proximity;
}

.setup-palette .shop-item {
  min-width: 174px;
  min-height: 74px;
  flex: 0 0 174px;
  scroll-snap-align: start;
}

.start-treatment-wrap {
  display: grid;
  min-width: min(370px, 42vw);
  grid-template-columns: minmax(220px, 1fr) minmax(160px, 0.8fr);
  gap: 0.75rem;
  align-items: center;
}

.cc-button--start {
  min-height: 70px;
}

.start-treatment-wrap .disabled-reason {
  margin: 0;
}

/* Live game shell */

.game-shell {
  display: grid;
  height: 100dvh;
  grid-template:
    'rail field panel' minmax(0, 1fr)
    'bottom bottom bottom' 72px
    / 100px minmax(0, 1fr) 280px;
  overflow: hidden;
}

.channel-rail {
  z-index: 5;
  grid-area: rail;
  display: flex;
  min-width: 100px;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: max(0.55rem, env(safe-area-inset-top)) 4px 0.55rem;
  border-right: 1px solid var(--panel-edge);
  background: var(--panel);
}

.channel-rail__title {
  display: block;
  width: 100%;
  padding-block: 0.35rem;
  font-size: 0.55rem;
  text-align: center;
  writing-mode: vertical-rl;
}

.channel-toggle {
  display: grid;
  width: 56px;
  min-width: 56px;
  height: 56px;
  min-height: 56px;
  grid-template-rows: auto 1fr;
  gap: 1px;
  place-items: center;
  padding: 0.2rem;
  border-radius: 7px;
}

.channel-toggle__dot {
  margin: 0;
  color: currentColor;
  font-size: 1rem;
  filter: drop-shadow(0 0 5px currentColor);
}

.channel-toggle__short {
  max-width: 48px;
  overflow: hidden;
  color: var(--ink-dim);
  font-size: 0.47rem;
  letter-spacing: 0;
  line-height: 1;
  text-align: center;
  text-overflow: ellipsis;
  text-transform: none;
  white-space: nowrap;
}

.channel--cart {
  color: var(--ch-cart);
}

.channel--cd8 {
  color: var(--ch-cd8);
}

.channel--cd4 {
  color: var(--ch-cd4);
}

.channel--macro {
  color: var(--ch-macro);
}

.channel--tumor {
  color: var(--ch-tumor);
}

.tissue-region {
  position: relative;
  grid-area: field;
  display: grid;
  min-width: 0;
  min-height: 0;
  place-items: center;
  overflow: hidden;
  background: var(--void);
}

.tissue-canvas {
  width: 100%;
  height: 100%;
  max-width: calc((100dvh - 72px) * 1.5);
  max-height: calc((100vw - 344px) / 1.5);
  aspect-ratio: 3 / 2;
  background: var(--tissue);
}

.live-panel {
  grid-area: panel;
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 1.1rem;
  padding: 1rem;
  overflow: auto;
  border-width: 0 0 0 1px;
}

.ui-hud-fallback,
.cc-hud {
  display: grid;
  gap: 1.1rem;
}

.cc-hud__meter {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 0.35rem 0.75rem;
  align-items: baseline;
}

.cc-hud__label,
.cc-hud__roster-heading {
  color: var(--ink-dim);
  font-size: var(--type-label);
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.cc-hud__value {
  min-width: 5ch;
  color: var(--ink);
  font-weight: 800;
  text-align: right;
}

.cc-hud__meter--tumor .cc-hud__value {
  color: var(--ch-tumor);
  font-family: var(--font-display);
  font-size: 2.7rem;
  letter-spacing: -0.05em;
  line-height: 1;
}

.cc-hud__track {
  grid-column: 1 / -1;
  height: 9px;
  overflow: hidden;
  border: 1px solid var(--panel-edge);
  border-radius: 2px;
  background: var(--tissue);
}

.cc-hud__fill {
  display: block;
  width: 0;
  height: 100%;
  background: var(--ch-cart);
}

.cc-hud__meter--tumor .cc-hud__fill {
  background: var(--ch-tumor);
}

.cc-hud__meter--health .cc-hud__fill {
  background: var(--ok);
}

.cc-hud__meter--crs .cc-hud__fill {
  background: var(--danger);
}

.cc-hud__roster {
  display: grid;
  gap: 0.35rem;
  padding-top: 0.8rem;
  border-top: 1px solid var(--panel-edge);
}

.cc-hud__roster-heading {
  margin: 0 0 0.35rem;
}

.cc-hud__roster-item {
  display: flex;
  min-height: 28px;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  color: var(--ink-dim);
  font-size: 0.72rem;
}

.cc-hud__roster-value {
  color: var(--ink);
  font-weight: 800;
}

.headline-readout {
  display: grid;
  gap: 0.2rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--panel-edge);
}

.headline-readout strong {
  color: var(--ch-tumor);
  font-family: var(--font-display);
  font-size: clamp(2.8rem, 4.5vw, 4.2rem);
  font-weight: 850;
  letter-spacing: -0.06em;
  line-height: 0.9;
}

.time-readout {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.time-readout strong {
  color: var(--ink);
  font-size: 1.2rem;
}

.roster-panel {
  padding-top: 0.8rem;
  border-top: 1px solid var(--panel-edge);
}

.roster-item {
  display: grid;
  min-height: 32px;
